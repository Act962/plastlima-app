# Mesmo MongoDB do app web.
DATABASE_URL="mongodb://localhost:27017/plastlima?replicaSet=rs0"

# Segredo de assinatura das sessões. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3002"

# Revalidação do cache do site ao publicar. Precisa ser o MESMO valor do
# REVALIDATE_SECRET no apps/web; sem ele o admin só loga a intenção (o site
# renova pelo ISR). PUBLIC_SITE_URL é a base do site a notificar.
REVALIDATE_SECRET=""
PUBLIC_SITE_URL="http://localhost:3001"

# Preview (draft mode): assina o token do botão "Visualizar". Precisa ser o MESMO
# valor do PREVIEW_SECRET no apps/web. Sem ele, o botão avisa que está indisponível.
PREVIEW_SECRET=""

# Cloudflare R2 (biblioteca de mídia). Sem estas variáveis, a tela de Mídia
# mostra o upload como indisponível. R2_PUBLIC_URL é o domínio público do bucket
# (o mesmo precisa estar no apps/web, para o next/image aceitar as imagens).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL="https://cdn.seu-dominio.com"
