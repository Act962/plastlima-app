		"@plastlima-app/core": "workspace:*",
		"@plastlima-app/infra": "workspace:*",
		"@plastlima-app/ui": "workspace:*",
		"@prisma/client": "catalog:",
		"better-auth": "^1.6.25",
		"lucide-react": "catalog:",
		"next": "^16.2.12",
		"react": "catalog:",
		"react-dom": "catalog:",
		"react-dropzone": "^20.0.0",
		"sonner": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@plastlima-app/config": "workspace:*",
		"@tailwindcss/postcss": "catalog:",
