# Origem pública do site (canonical, OpenGraph, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL="https://www.plastlima.com.br"

CORS_ORIGIN="http://localhost:3001"

# MongoDB do sorteio. Precisa ser um replica set — o Atlas já é.
# Em desenvolvimento, `pnpm run db:up` sobe um via docker-compose.
DATABASE_URL="mongodb://localhost:27017/plastlima?replicaSet=rs0"
