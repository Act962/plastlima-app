# Origem pública do site (canonical, OpenGraph, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL="https://www.plastlima.com.br"

CORS_ORIGIN="http://localhost:3001"

# MongoDB do sorteio e do CMS. Precisa ser um replica set — o Atlas já é.
# Em desenvolvimento, `pnpm run db:up` sobe um via docker-compose.
DATABASE_URL="mongodb://localhost:27017/plastlima?replicaSet=rs0"

# Segredo compartilhado com o admin para a rota de revalidação de cache
# (POST /api/revalidate). Precisa ser idêntico ao do admin. Sem ele, o endpoint
# rejeita tudo e o site só se atualiza pelo ISR (revalidate periódico).
REVALIDATE_SECRET=""

# Segredo compartilhado com o admin para o preview (draft mode). Precisa ser
# idêntico ao do admin. Sem ele, /api/preview rejeita todos os tokens.
PREVIEW_SECRET=""

# Domínio público do bucket R2 (mídia). Só o site precisa dele — é o que libera
# as imagens do R2 no next/image (images.remotePatterns). Mesmo valor do admin.
R2_PUBLIC_URL="https://cdn.seu-dominio.com"
