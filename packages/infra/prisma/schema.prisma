generator client {
  provider = "prisma-client-js"
  // Sem `output`: o cliente vai para node_modules/.prisma/client, o local que
  // `serverExternalPackages` do Next reconhece. Gerar dentro de src/ fazia o
  // rastreio de dependências do Turbopack empacotar o projeto inteiro.
  //
  // "native" cobre a máquina de desenvolvimento. O runtime serverless da Vercel
  // é Amazon Linux (base RHEL), não Debian — com o alvo errado o build passa e o
  // deploy quebra ao abrir a primeira conexão. Trocar por `debian-openssl-3.0.x`
  // só se a hospedagem virar Docker sobre Debian.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// Uma pessoa inscrita numa campanha de sorteio.
///
/// O índice único (campaignId, phone) é o que garante o requisito "uma pessoa se
/// cadastra uma vez": a deduplicação é responsabilidade do banco, não apenas de
/// uma checagem na aplicação, que perderia a corrida entre duas submissões
/// simultâneas do mesmo número.
model Participant {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  campaignId String

  name         String
  /// E.164 sem o "+", ex.: 5586988970955. Chave de deduplicação.
  phone        String
  /// Formato legível para a equipe copiar, ex.: (86) 98897-0955.
  phoneDisplay String

  /// Snapshot da loja no momento do cadastro. Renomear a loja depois não pode
  /// reescrever onde a pessoa comprou de fato.
  storeId   String
  storeName String
  city      String
  state     String

  /// Data URL da imagem do cupom, comprimida pelo navegador antes do envio.
  receiptImage String?

  /// Quantas vezes a pessoa se cadastrou. Métrica de engajamento — uma pessoa
  /// continua valendo uma chance no sorteio.
  participationCount Int @default(1)

  acceptedTermsAt    DateTime
  createdAt          DateTime @default(now())
  lastParticipatedAt DateTime

  @@unique([campaignId, phone])
  @@index([campaignId, createdAt])
  @@index([campaignId, name])
}

// ---------------------------------------------------------------------------
// CMS — conteúdo editável do site (spec docs/spec-dashboard-cms.md §4).
// Um documento por área do site; o formato de cada `key` é definido por um
// schema Zod em packages/core, não pelo banco.
// ---------------------------------------------------------------------------

/// Um documento de conteúdo editável: rascunho (`draft`) e publicado
/// (`published`) guardados como JSON, validados na fronteira pelo schema Zod da
/// respectiva `key`.
///
/// `currentVersion` é denormalizado (o maior número de revisão já criado): evita
/// um `count` a cada leitura e é gravado na mesma transação da revisão, mantendo
/// a sequência consistente. `updatedAt` é controlado pelo domínio (relógio
/// injetado), não por `@updatedAt` — a fonte de tempo é uma só.
model ContentDocument {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  key           String    @unique // "home" | "about" | "locations" | ...
  schemaVersion Int       @default(1)
  draft         Json
  published     Json?
  currentVersion Int      @default(0)
  publishedAt   DateTime?
  publishedBy   String?
  updatedAt     DateTime
  updatedBy     String

  revisions ContentRevision[]
}

/// Snapshot imutável do conteúdo no momento de uma publicação — histórico e
/// rollback. Nunca é editado depois de criado.
///
/// O índice único `(documentId, version)` garante a sequência estrita de versões
/// no nível do banco: mesmo sob duas publicações simultâneas, só uma grava cada
/// número. `schemaVersion` registra o formato em que a revisão foi criada, para
/// a migração de shape na restauração (spec §5.2).
model ContentRevision {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  documentId    String          @db.ObjectId
  document      ContentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version       Int
  data          Json
  schemaVersion Int
  note          String?
  createdBy     String
  createdAt     DateTime        @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

/// Um arquivo de mídia enviado pelo painel e guardado no Cloudflare R2 (spec §5).
///
/// `storageKey` é derivado do `checksum` (SHA-256), nunca do nome original — dois
/// uploads do mesmo arquivo caem na mesma chave. O índice único em `checksum`
/// deduplica no nível do banco: um segundo upload idêntico devolve o registro
/// existente em vez de criar outro (invariante 5). `alt` é obrigatório (inv. 7).
model MediaAsset {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  storageKey String   @unique
  url        String
  alt        String
  width      Int
  height     Int
  bytes      Int
  mimeType   String
  checksum   String   @unique
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Better Auth — acesso ao painel administrativo.
// Não há cadastro público: os usuários são criados pelo seed (`db:seed-admin`).
// ---------------------------------------------------------------------------

model User {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  /// "owner" gerencia usuários; "editor" só consulta os participantes.
  role          String  @default("editor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash da senha (provider "credential"). Nunca a senha em texto.
  password              String?

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
}
