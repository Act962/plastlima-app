# Conexão do MongoDB. Precisa ser um replica set — o Atlas já é, e em
# desenvolvimento o docker-compose sobe um de um nó só (`pnpm run db:up`).
DATABASE_URL="mongodb://localhost:27017/plastlima?replicaSet=rs0"

# Banco usado pelos testes de integração. Mesmo container, outro nome, para os
# testes poderem limpar as coleções sem apagar os dados de desenvolvimento.
TEST_DATABASE_URL="mongodb://localhost:27017/plastlima_test?replicaSet=rs0"
